            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportType\": \"LOST\",\n  \"title\": \"Black umbrella\",\n  \"category\": \"OTHER\",\n  \"colour\": \"BLACK\",\n  \"description\": \"A long black umbrella with a wooden handle.\",\n  \"generalLocation\": \"NOT_SURE\",\n  \"dateOccurred\": \"2099-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
