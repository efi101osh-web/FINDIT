{
  "info": {
    "name": "FINDIT API",
    "description": "Requests for trying the FINDIT backend. Start the backend first (npm run dev), then run the requests in order: 0 to 13. Each request has tests: a green \"PASS\" in the Test Results tab means the API behaved correctly. The folder at the end contains requests that SHOULD be refused. For those, a \"PASS\" means the refusal worked.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "Sunrise2026"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "lostItemId",
      "value": ""
    },
    {
      "key": "foundItemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('server answers 200', () => pm.response.to.have.status(200));",
              "pm.test('database is connected', () => pm.expect(pm.response.json().data.database).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Register (creates a new test account)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Postman Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('email', 'tester' + Date.now() + '@example.com');",
              "pm.collectionVariables.set('password', 'Sunrise2026');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('the new account is a regular user', () => pm.expect(pm.response.json().data.user.role).to.eql('user'));",
              "pm.test('the password hash is never returned', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));",
              "pm.collectionVariables.set('token', pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('a token is returned', () => pm.expect(pm.response.json().data.token).to.be.a('string'));",
              "pm.collectionVariables.set('token', pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Who am I",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('it is my account', () => pm.expect(pm.response.json().data.user.email).to.eql(pm.collectionVariables.get('email')));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Update my profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Postman Tester Updated\",\n  \"contactPreference\": \"EMAIL\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('the change was saved', () => pm.expect(pm.response.json().data.user.fullName).to.eql('Postman Tester Updated'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Change my password",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/me/password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"Moonrise2027\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('password', 'Moonrise2027');"
            ]
          }
        }
      ]
    },
    {
      "name": "6. See the place options (zones and halls)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/meta/options",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const zones = pm.response.json().data.campusLocations;",
              "pm.test('there are zones to choose from', () => pm.expect(zones.length).to.be.above(10));",
              "pm.test('male halls is a pick-list that includes Winslow', () => { const z = zones.find(x => x.code === 'MALE_HALLS'); pm.expect(z.detail.mode).to.eql('LIST'); pm.expect(z.detail.options).to.include('Winslow'); });",
              "pm.test('the library asks for a short description', () => pm.expect(zones.find(x => x.code === 'LIBRARY').detail.mode).to.eql('REQUIRED_TEXT'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Report a LOST item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reportType\": \"LOST\",\n  \"title\": \"Black wireless headphones\",\n  \"category\": \"ELECTRONICS\",\n  \"colour\": \"BLACK\",\n  \"description\": \"Over-ear wireless headphones in a black hard case.\",\n  \"generalLocation\": \"LIBRARY\",\n  \"locationDetail\": \"Main library, second floor\",\n  \"dateOccurred\": \"{{today}}\",\n  \"approximateTime\": \"AFTERNOON\",\n  \"privateDetails\": \"Scratch on the left earcup; blue sticker inside the case.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('today', new Date().toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const item = pm.response.json().data.item;",
              "pm.test('it starts OPEN and belongs to me', () => { pm.expect(item.status).to.eql('OPEN'); pm.expect(item.isMine).to.eql(true); });",
              "pm.test('I can see my own private details', () => pm.expect(item.privateDetails).to.include('blue sticker'));",
              "pm.collectionVariables.set('lostItemId', item.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Report a FOUND item (a male hall, chosen from the list)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reportType\": \"FOUND\",\n  \"title\": \"Set of keys on a red lanyard\",\n  \"category\": \"KEYS\",\n  \"colour\": \"RED\",\n  \"description\": \"Three keys on a red lanyard, found on a bench outside.\",\n  \"generalLocation\": \"MALE_HALLS\",\n  \"locationDetail\": \"Winslow\",\n  \"dateOccurred\": \"{{today}}\",\n  \"approximateTime\": \"MORNING\",\n  \"privateDetails\": \"One key has a green rubber cap.\",\n  \"handedToOffice\": true,\n  \"privateStorageLocation\": \"Security Office, shelf B\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const item = pm.response.json().data.item;",
              "pm.test('it is a FOUND report with the hall I chose', () => { pm.expect(item.reportType).to.eql('FOUND'); pm.expect(item.locationDetail).to.eql('Winslow'); });",
              "pm.collectionVariables.set('foundItemId', item.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "9. My reports",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items/mine"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('both of my reports are listed, newest first', () => { const ids = body.data.map(i => i.id); pm.expect(ids).to.include(pm.collectionVariables.get('lostItemId')); pm.expect(ids[0]).to.eql(pm.collectionVariables.get('foundItemId')); });",
              "pm.test('the list never shows private details', () => { pm.expect(pm.response.text()).to.not.include('privateDetails'); pm.expect(pm.response.text()).to.not.include('Security Office'); });",
              "pm.test('paging information is included', () => pm.expect(body.meta.total).to.be.at.least(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. View one of my reports",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items/{{foundItemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('as the owner I see the private storage location', () => pm.expect(pm.response.json().data.item.privateStorageLocation).to.eql('Security Office, shelf B'));",
              "pm.test('my own contact details are not repeated back', () => pm.expect(pm.response.json().data.item).to.not.have.property('reporter'));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Edit my LOST report (move it to a female hall)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items/{{lostItemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"brand\": \"Sony\",\n  \"approximateTime\": \"EVENING\",\n  \"generalLocation\": \"FEMALE_HALLS\",\n  \"locationDetail\": \"Queen Esther\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const item = pm.response.json().data.item;",
              "pm.test('only the sent fields changed', () => { pm.expect(item.brand).to.eql('Sony'); pm.expect(item.generalLocation).to.eql('FEMALE_HALLS'); pm.expect(item.locationDetail).to.eql('Queen Esther'); pm.expect(item.title).to.eql('Black wireless headphones'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Close my LOST report (\"found it myself\")",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items/{{lostItemId}}/close",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Found it in my bag.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('it is now CLOSED with my reason', () => { const item = pm.response.json().data.item; pm.expect(item.status).to.eql('CLOSED'); pm.expect(item.closeReason).to.eql('Found it in my bag.'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Optional: log in as the ADMINISTRATOR (fill adminEmail and adminPassword in the collection Variables first)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Uses the account you created with npm run seed:admin. Open the collection, go to the Variables tab, and type your admin email and password into the CURRENT VALUE column of adminEmail and adminPassword. Do not share the collection after filling them in."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('this account is an administrator', () => pm.expect(pm.response.json().data.user.role).to.eql('admin'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Things that SHOULD be refused (a PASS means the refusal worked)",
      "item": [
        {
          "name": "Register trying to become an admin (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sneaky Person\",\n  \"email\": \"sneaky{{$timestamp}}@example.com\",\n  \"password\": \"Sunrise2026\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400: the role field is refused', () => pm.response.to.have.status(400));",
                  "pm.test('it names the forbidden field', () => pm.expect(pm.response.json().error.details.map(d => d.field)).to.include('role'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"DefinitelyWrong9\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 INVALID_CREDENTIALS', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I WITHOUT a token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 UNAUTHENTICATED', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Change my email through the profile (expect 400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hijack@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
