{
  "name": "findit-backend",
  "version": "0.1.0",
  "description": "FINDIT: Smart Campus Lost & Found Management System. REST API.",
  "private": true,
  "license": "UNLICENSED",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:db": "node scripts/testWithDatabase.js",
    "check:db": "node scripts/checkDatabase.js",
    "make:secret": "node scripts/generateSecret.js",
    "seed:admin": "node scripts/seedAdmin.js"
  },
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/setup/globalTeardown.js",
    "testTimeout": 20000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server-core": "^11.4.0",
    "supertest": "^7.3.2"
  }
}
