# Copy this file to ".env" in the same folder and adjust the values.
# ".env" is private and is never committed to Git. This example file is safe to commit
# because it contains only harmless sample values.

# development | test | production
NODE_ENV=development

# The port the API listens on.
PORT=4000

# --- Database (MongoDB Atlas) ---------------------------------------------------------
# Your connection string from Atlas. THIS IS A SECRET (it contains the database password).
# Never share it, never commit it, never paste it into a chat.
# It looks like this, with your own values in place of the <...> parts:
#   mongodb+srv://<db_username>:<db_password>@<your-cluster-address>/?retryWrites=true&w=majority
# Replace the WHOLE placeholder including the < and > signs. See documentation/SETUP_GUIDE.md Part 3.
MONGODB_URI=

# The name of the database inside your cluster. Leave as "findit" unless told otherwise.
MONGODB_DB_NAME=findit

# How long to wait for the database when connecting, in milliseconds. 10000 = 10 seconds.
# On a slow or mobile connection (MiFi, hotspot) try 30000.
# MONGODB_TIMEOUT_MS=10000

# --- Browsers allowed to call the API (the admin dashboard) ----------------------------
# Comma-separated list, each like http://host:port with no path. "*" is not allowed.
CORS_ORIGINS=http://localhost:5173

# --- Login security -----------------------------------------------------------------------
# The secret key that signs login tokens. THIS IS A SECRET. Never share or commit it.
# Generate one by running:  npm run make:secret   and paste the result here (no quotes, no spaces).
# If this key ever leaks, anyone could forge logins: make a new one (everyone is then logged out).
JWT_SECRET=

# How long a login lasts: a number and m (minutes), h (hours) or d (days). At most 30d.
JWT_EXPIRES_IN=7d

# How slow password hashing is, on purpose (4 to 15). Higher is safer but slower. 12 is a good
# choice; it takes about half a second per login on a modest laptop. Leave as is unless told otherwise.
# BCRYPT_ROUNDS=12

# Optional: only these email domains may sign up (comma-separated), e.g. your university's.
# Leave empty to allow any email address.
ALLOWED_EMAIL_DOMAINS=

# --- First administrator (used ONLY by: npm run seed:admin) ------------------------------------
# Fill these in, run  npm run seed:admin  once, then DELETE the SEED_ADMIN_PASSWORD line.
# The password needs 8+ characters with at least one letter and one number.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Campus Administrator

# --- Optional: rate limit tuning (the defaults are sensible; raise them for a big demo) -----
# RATE_LIMIT_GLOBAL_MAX=600        requests per address per 15 minutes
# RATE_LIMIT_LOGIN_FAILURES=10     FAILED logins per address + email per 15 minutes
# RATE_LIMIT_REGISTER_MAX=20       sign-up requests per address per hour
