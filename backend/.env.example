# Copy this file to ".env" in the same folder and adjust the values.
# ".env" is private and is never committed to Git. This example file is safe to commit
# because it contains only harmless sample values.

# development | test | production
NODE_ENV=development

# The port the API listens on.
PORT=4000

# --- Database (MongoDB Atlas) ---------------------------------------------------------
# Your connection string from Atlas. THIS IS A SECRET (it contains the database password).
# Never share it, never commit it, never paste it into a chat.
# It looks like this, with your own values in place of the <...> parts:
#   mongodb+srv://<db_username>:<db_password>@<your-cluster-address>/?retryWrites=true&w=majority
# Replace the WHOLE placeholder including the < and > signs. See documentation/SETUP_GUIDE.md Part 3.
MONGODB_URI=

# The name of the database inside your cluster. Leave as "findit" unless told otherwise.
MONGODB_DB_NAME=findit

# --- Browsers allowed to call the API (the admin dashboard) ----------------------------
# Comma-separated list, each like http://host:port with no path. "*" is not allowed.
CORS_ORIGINS=http://localhost:5173
